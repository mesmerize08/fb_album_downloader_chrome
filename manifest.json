{
  "manifest_version": 3,
  "name": "Facebook Album Downloader",
  "version": "0.1.0",
  "description": "Download photos from an album you can view on Facebook.",
  "minimum_chrome_version": "116",
  "permissions": ["downloads", "storage", "sidePanel", "alarms"],
  "host_permissions": ["https://www.facebook.com/*", "https://*.facebook.com/*", "https://*.fbcdn.net/*"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Facebook Album Downloader",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": { "default_path": "sidepanel/sidepanel.html" },
  "background": { "service_worker": "background.js" },
  "content_scripts": [{
    "matches": ["https://www.facebook.com/*", "https://*.facebook.com/*"],
    "js": ["shared/utils.js", "shared/messages.js", "content/facebook-adapter.js", "content/album-scanner.js", "content/photo-resolver.js", "content/content.js"],
    "run_at": "document_idle"
  }]
}
